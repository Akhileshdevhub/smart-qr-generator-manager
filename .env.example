# Copy this file to ".env" and fill in real values. NEVER commit your .env.
#
# Generate a strong secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# "development" or "production"
ENVIRONMENT=development

# Secret used to sign JWTs. MUST be long and random in production.
SECRET_KEY=change-me-to-a-long-random-string

# Public base URL of the app. Dynamic QR codes encode "<BASE_URL>/r/<short_id>",
# so this value is baked into every printed dynamic QR — set it to your real
# domain in production (e.g. https://qr.yourdomain.com).
BASE_URL=http://localhost:8000

# Database connection string.
#   SQLite (default, zero setup):   sqlite:///./qr_app.db
#   PostgreSQL (production):        postgresql+psycopg://user:pass@host:5432/qrdb
DATABASE_URL=sqlite:///./qr_app.db
